{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/renderer/*"],
      "monaco-editor/esm/vs/editor/editor.api": ["node_modules/monaco-editor"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
